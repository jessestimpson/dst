%% For rebar3 consumers. Mix builds this app from `mix.exs` and never reads this
%% file, so `vsn` and `description` are duplicated between the two and have to be
%% changed together.
{application, eta, [
    {description,
        "Deterministic simulation testing for the BEAM: a serializing scheduler, "
        "a virtual clock, and a driver that turns a seed into a replayable run."},
    {vsn, "0.1.0"},
    {registered, []},
    %% No `mod` entry: `eta` starts nothing of its own. `eta_time` and `eta_log`
    %% own named ETS tables created on demand and torn down with the run.
    {applications, [kernel, stdlib, logger]},
    {env, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/jessestimpson/eta"}]}
]}.
